[HKEY_CURRENT_USER\Software\Classes\Directory\shell\SystemTools\shell\03ClearIconCache\command]
@="wscript.exe \"D:\\Users\\joty79\\scripts\\SystemTools\\Launch-ClearIconCache.vbs\""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\SystemTools\shell\20PathManager]
