[HKEY_CURRENT_USER\Software\Classes\Directory\shell\SystemTools\shell\20PathManager\command]
@="wscript.exe \"D:\\Users\\joty79\\scripts\\SystemTools\\Launch-SystemToolsMenu.vbs\" \"%1\""

